{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Film",
    "description": "A film in the Film Manager platform",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Unique identifier of the film in the Film Manager platform"
        },
        "title": {
            "type": "string",
            "description": "Title of the film",
            "minLength": 1
        },
        "owner": {
            "type": "integer",
            "description": "Id of the user who owns the film"
        },
        "private": {
            "type": "boolean",
            "description": "Indicates if the film is private"
        },
        "watchDate": {
            "type": "string",
            "format": "date",
            "description": "The date when the film was watched"
        },
        "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Rating of the film (0-10)"
        },
        "favorite": {
            "type": "boolean",
            "description": "Indicates if the film is marked as favorite",
            "default": false
        }
    },
    "required": [
        "id",
        "title",
        "owner",
        "private"
    ],
    "if": {
        "properties": {
            "private": {
                "const": false
            }
        }
    },
    "then": {
        "properties": {
            "watchDate": false,
            "rating": false,
            "favorite": false
        }
    },
    "additionalProperties": true
}